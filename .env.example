# ==============================================================================
# SistemaInventarioVentas — Environment Configuration Template
# Copy this file to .env or export these variables in your shell environment.
# DO NOT COMMIT REAL SECRETS, PASSWORDS, OR PRODUCTION KEYS TO SOURCE CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# PostgreSQL Database Configuration (Docker Compose & Infrastructure)
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_DB=inventario
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# Backend Connection String (.NET 10 ASP.NET Core API)
# ------------------------------------------------------------------------------
ConnectionStrings__InventoryDatabase=Host=localhost;Port=5432;Database=inventario;Username=postgres;Password=your_secure_postgres_password_here

# ------------------------------------------------------------------------------
# JWT Authentication Settings
# - SigningKey MUST be at least 32 UTF-8 bytes (HMAC-SHA256 requirement)
# - AccessTokenLifetimeMinutes MUST be an integer between 1 and 60
# ------------------------------------------------------------------------------
Authentication__Jwt__Issuer=SistemaInventarioVentas.API
Authentication__Jwt__Audience=SistemaInventarioVentas.Client
Authentication__Jwt__SigningKey=your_at_least_32_bytes_super_secret_jwt_key_here!
Authentication__Jwt__AccessTokenLifetimeMinutes=15

# ------------------------------------------------------------------------------
# Frontend & Production Compose Settings (docker-compose.prod.yml)
# ------------------------------------------------------------------------------
FRONTEND_PORT=80
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5008

# ------------------------------------------------------------------------------
# Optional E2E Integration Suite Settings (scripts/e2e-integration-validation.mjs)
# ------------------------------------------------------------------------------
# BASE_URL=http://localhost:4200
# DB_CONTAINER=sistema-inventario-db
# DB_NAME=inventario
